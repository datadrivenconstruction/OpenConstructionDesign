family Overhead Crane
category equipment
host floor
ifc IfcTransportElement LIFTINGGEAR
param Span length type 22500mm
param Capacity number type 10
param Gauge length type 2500mm
param Carriage length type 600mm
param CarriageW length type 400mm
param Wheelbase length type = max(3000mm, Span / 7)
param Girder length type = max(600mm, Span / 18)
param GirderW length type = 400mm + Capacity * 10mm
param TrolleyW length type 1800mm
param TrolleyL length type = Gauge + GirderW
param TrolleyH length type = 700mm + Capacity * 20mm
param Block length type 800mm
param Steel material type "Steel Grey"
ref Left x = -Span / 2
ref Right x = Span / 2
type "10 t 22.5 m" Span=22500mm, Capacity=10
type "5 t 16.5 m" Span=16500mm, Capacity=5
type "20 t 28.5 m" Span=28500mm, Capacity=20
type "10 t 72ft span 864in" Span=864in, Capacity=10
extrude CarriageL rect(Left - CarriageW / 2, -Wheelbase / 2, Left + CarriageW / 2, Wheelbase / 2) z(0mm, Carriage) mat(Steel) show(3d, elev)
extrude CarriageR rect(Right - CarriageW / 2, -Wheelbase / 2, Right + CarriageW / 2, Wheelbase / 2) z(0mm, Carriage) mat(Steel) show(3d, elev)
extrude GirderA rect(Left, -Gauge / 2 - GirderW / 2, Right, -Gauge / 2 + GirderW / 2) z(Carriage, Carriage + Girder) mat(Steel) show(3d, elev)
extrude GirderB rect(Left, Gauge / 2 - GirderW / 2, Right, Gauge / 2 + GirderW / 2) z(Carriage, Carriage + Girder) mat(Steel) show(3d, elev)
extrude Trolley rect(-TrolleyW / 2, -TrolleyL / 2, TrolleyW / 2, TrolleyL / 2) z(Carriage + Girder, Carriage + Girder + TrolleyH) mat(Steel) show(3d, elev)
extrude HookBlock rect(-Block / 2, -Block / 2, Block / 2, Block / 2) z(Carriage, Carriage + Block) mat(Steel) show(medium, fine, 3d, elev)
symbol rect(Left - CarriageW / 2, -Wheelbase / 2, Right + CarriageW / 2, Wheelbase / 2)
symbol rect(-TrolleyW / 2, -TrolleyL / 2, TrolleyW / 2, TrolleyL / 2)
symbol line(Left, -Gauge / 2, Right, -Gauge / 2) show(medium, fine)
symbol line(Left, Gauge / 2, Right, Gauge / 2) show(medium, fine)
