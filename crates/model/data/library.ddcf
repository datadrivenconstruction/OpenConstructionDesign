family Planter
category planting
host floor
ifc IfcGeographicElement NOTDEFINED
param Lift length type 0mm
param Length length type 2000mm
param Width length type 600mm
param Box length type 500mm
param Timber material type "Timber Larch"
param Leaves material type "Foliage Green"
type "H0" Lift=0mm
type "H2.7" Lift=2950mm
type "H3.0" Lift=3250mm
type "H3.3" Lift=3550mm
type "H3.6" Lift=3850mm
type "H3.9" Lift=4150mm
type "H4.2" Lift=4450mm
type "H4.5" Lift=4750mm
type "H4.8" Lift=5050mm
type "H5.1" Lift=5350mm
type "H5.4" Lift=5650mm
type "H5.7" Lift=5950mm
type "H6.0" Lift=6250mm
type "H130in" Lift=130in
extrude Body rect(-Length / 2, -Width / 2, Length / 2, Width / 2) z(Lift, Lift + Box) mat(Timber) show(3d, elev)
extrude Shrub rect(-Length / 2 + 100mm, -Width / 2 + 100mm, Length / 2 - 100mm, Width / 2 - 100mm) z(Lift + Box, Lift + Box + 600mm) mat(Leaves) show(3d, elev)
symbol rect(-Length / 2, -Width / 2, Length / 2, Width / 2)
---
family Hedge
category planting
host floor
ifc IfcGeographicElement NOTDEFINED
# One clipped length of a hedge, laid end to end along a boundary; Height is the clipped height.
# Six cuts along the length, each with its own top height and width (seeded by Scale, which the
# generator jitters per length), a trimmed shoulder under a narrower top, and a scalloped plan edge.
param Length length type 3000mm
param Width length type 600mm
param Height length type 1200mm
param Scale number instance 1
param Leaves material type "Foliage Green"
type "Clipped 1200" Height=1200mm
type "Low 600" Height=600mm, Width=500mm
type "Tall 1800" Height=1800mm, Width=800mm
type "Conifer 2000" Height=2000mm, Width=800mm, Leaves="Foliage Conifer"
type "120x24x48in" Length=120in, Width=24in, Height=48in
extrude Base0 rect((-Length / 2 + Length * 0 / 6), -(Width * Scale * (1 + 0.06 * cos(Scale * 61 + 0 * 1.9))) / 2, (-Length / 2 + Length * 1 / 6), (Width * Scale * (1 + 0.06 * cos(Scale * 61 + 0 * 1.9))) / 2) z(0mm, 0.75 * (Height * Scale * (1 + 0.08 * sin(Scale * 97 + 0 * 2.3)))) mat(Leaves) show(3d, elev)
extrude Top0 rect((-Length / 2 + Length * 0 / 6), -0.4 * (Width * Scale * (1 + 0.06 * cos(Scale * 61 + 0 * 1.9))), (-Length / 2 + Length * 1 / 6), 0.4 * (Width * Scale * (1 + 0.06 * cos(Scale * 61 + 0 * 1.9)))) z(0.75 * (Height * Scale * (1 + 0.08 * sin(Scale * 97 + 0 * 2.3))), (Height * Scale * (1 + 0.08 * sin(Scale * 97 + 0 * 2.3)))) mat(Leaves) show(3d, elev)
extrude Base1 rect((-Length / 2 + Length * 1 / 6), -(Width * Scale * (1 + 0.06 * cos(Scale * 61 + 1 * 1.9))) / 2, (-Length / 2 + Length * 2 / 6), (Width * Scale * (1 + 0.06 * cos(Scale * 61 + 1 * 1.9))) / 2) z(0mm, 0.75 * (Height * Scale * (1 + 0.08 * sin(Scale * 97 + 1 * 2.3)))) mat(Leaves) show(3d, elev)
extrude Top1 rect((-Length / 2 + Length * 1 / 6), -0.4 * (Width * Scale * (1 + 0.06 * cos(Scale * 61 + 1 * 1.9))), (-Length / 2 + Length * 2 / 6), 0.4 * (Width * Scale * (1 + 0.06 * cos(Scale * 61 + 1 * 1.9)))) z(0.75 * (Height * Scale * (1 + 0.08 * sin(Scale * 97 + 1 * 2.3))), (Height * Scale * (1 + 0.08 * sin(Scale * 97 + 1 * 2.3)))) mat(Leaves) show(3d, elev)
extrude Base2 rect((-Length / 2 + Length * 2 / 6), -(Width * Scale * (1 + 0.06 * cos(Scale * 61 + 2 * 1.9))) / 2, (-Length / 2 + Length * 3 / 6), (Width * Scale * (1 + 0.06 * cos(Scale * 61 + 2 * 1.9))) / 2) z(0mm, 0.75 * (Height * Scale * (1 + 0.08 * sin(Scale * 97 + 2 * 2.3)))) mat(Leaves) show(3d, elev)
extrude Top2 rect((-Length / 2 + Length * 2 / 6), -0.4 * (Width * Scale * (1 + 0.06 * cos(Scale * 61 + 2 * 1.9))), (-Length / 2 + Length * 3 / 6), 0.4 * (Width * Scale * (1 + 0.06 * cos(Scale * 61 + 2 * 1.9)))) z(0.75 * (Height * Scale * (1 + 0.08 * sin(Scale * 97 + 2 * 2.3))), (Height * Scale * (1 + 0.08 * sin(Scale * 97 + 2 * 2.3)))) mat(Leaves) show(3d, elev)
extrude Base3 rect((-Length / 2 + Length * 3 / 6), -(Width * Scale * (1 + 0.06 * cos(Scale * 61 + 3 * 1.9))) / 2, (-Length / 2 + Length * 4 / 6), (Width * Scale * (1 + 0.06 * cos(Scale * 61 + 3 * 1.9))) / 2) z(0mm, 0.75 * (Height * Scale * (1 + 0.08 * sin(Scale * 97 + 3 * 2.3)))) mat(Leaves) show(3d, elev)
extrude Top3 rect((-Length / 2 + Length * 3 / 6), -0.4 * (Width * Scale * (1 + 0.06 * cos(Scale * 61 + 3 * 1.9))), (-Length / 2 + Length * 4 / 6), 0.4 * (Width * Scale * (1 + 0.06 * cos(Scale * 61 + 3 * 1.9)))) z(0.75 * (Height * Scale * (1 + 0.08 * sin(Scale * 97 + 3 * 2.3))), (Height * Scale * (1 + 0.08 * sin(Scale * 97 + 3 * 2.3)))) mat(Leaves) show(3d, elev)
extrude Base4 rect((-Length / 2 + Length * 4 / 6), -(Width * Scale * (1 + 0.06 * cos(Scale * 61 + 4 * 1.9))) / 2, (-Length / 2 + Length * 5 / 6), (Width * Scale * (1 + 0.06 * cos(Scale * 61 + 4 * 1.9))) / 2) z(0mm, 0.75 * (Height * Scale * (1 + 0.08 * sin(Scale * 97 + 4 * 2.3)))) mat(Leaves) show(3d, elev)
extrude Top4 rect((-Length / 2 + Length * 4 / 6), -0.4 * (Width * Scale * (1 + 0.06 * cos(Scale * 61 + 4 * 1.9))), (-Length / 2 + Length * 5 / 6), 0.4 * (Width * Scale * (1 + 0.06 * cos(Scale * 61 + 4 * 1.9)))) z(0.75 * (Height * Scale * (1 + 0.08 * sin(Scale * 97 + 4 * 2.3))), (Height * Scale * (1 + 0.08 * sin(Scale * 97 + 4 * 2.3)))) mat(Leaves) show(3d, elev)
