extrude SideR rect(Right - Panel, Front, Right, Back) z(0, Height - Top) mat(Board) show(3d, elev)
extrude Modesty rect(Left + Panel, Back - 2 * Panel, Right - Panel, Back - Panel) z(Height - Top - Modesty, Height - Top) mat(Board) show(medium, fine, 3d, elev)
