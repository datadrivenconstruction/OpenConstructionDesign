family Shrub
category planting
host floor
ifc IfcGeographicElement NOTDEFINED
# A shrub: the same procedural plant as a tree, low; Scale (set per plant by the generator) sizes
# it and reseeds its lumps, so no two shrubs of a type are alike. Form 0 round 1 oval 6 vase 7 spreading.
param Form int type 0
param Height length type 1200mm
param Crown length type 1400mm
param Trunk length type 30mm
param Clear length type 100mm
param Leaf number type 1
param Seed int type 1
param Scale number instance 1
param Bark material type "Bark Brown"
param Leaves material type "Foliage Green"
type "Round 1" Form=0, Height=1100mm, Crown=1300mm, Seed=11
type "Round 2" Form=0, Height=1500mm, Crown=1700mm, Seed=12
type "Oval 1" Form=1, Height=1600mm, Crown=1100mm, Seed=13
type "Spreading 1" Form=7, Height=800mm, Crown=1800mm, Seed=14
type "Spreading 2" Form=7, Height=1000mm, Crown=2200mm, Seed=15, Leaves="Foliage Olive"
type "Vase 1" Form=6, Height=1800mm, Crown=1500mm, Clear=200mm, Seed=16
type "Lilac" Form=1, Height=2200mm, Crown=1800mm, Clear=250mm, Seed=17, Leaves="Foliage Spring"
type "Round 48in" Form=0, Height=48in, Crown=54in, Seed=18
plant Stem part(wood) form(Form) height(Height * Scale) crown(Crown * Scale) trunk(Trunk * Scale) clear(Clear * Scale) leaf(Leaf) seed(Seed + round(Scale * 100)) mat(Bark) show(plan, 3d, elev)
plant Crown part(foliage) form(Form) height(Height * Scale) crown(Crown * Scale) trunk(Trunk * Scale) clear(Clear * Scale) leaf(Leaf) seed(Seed + round(Scale * 100)) mat(Leaves) show(plan, 3d, elev)
