   "source": {
    "doc": "tr-fire",
    "clause": "Art. 48 para 2",
    "url": "https://www.aile.gov.tr/eyhgm/mevzuat/ulusal-mevzuat/yonetmelikler/binalarin-yangindan-korunmasi-hakkinda-yonetmelik/",
    "edition": "consolidated, amendments to 2015-03-16",
    "accessed": "2026-11-14",
    "paraphrase": "In dwellings above four storeys the run from any point inside a unit to its exit door is capped at 20 m, or 30 m if the unit is sprinklered."
   },
