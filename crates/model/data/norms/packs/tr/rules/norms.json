     "apartment",
     "apartment_section",
     "office"
    ],
    "room_kind": [
     "corridor"
    ]
   },
   "check": {
    "kind": "formula",
    "cat": "room",
    "expr": "width",
    "min": 1.5
   },
   "unit": "m",
   "value": 1.5,
   "text": {
    "en": "Accessible-route corridor clear width at least 1.5 m"
   },
   "source": {
    "doc": "tr-planli",
    "clause": "Art. 30 para 1",
    "url": "https://www.alomaliye.com/wp-content/uploads/2017/07/planli-alanlar-01-07-2026.pdf",
    "edition": "consolidated through the amendment of 2026-07-01 (RG 33297)",
    "accessed": "2026-11-14",
