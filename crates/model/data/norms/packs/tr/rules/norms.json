   "unit": "m",
   "value": 0.16,
   "text": {
    "en": "Common stair riser at most 0.16 m"
   },
   "source": {
    "doc": "tr-planli",
    "clause": "Art. 31 para 2 item a",
    "url": "https://www.alomaliye.com/wp-content/uploads/2017/07/planli-alanlar-01-07-2026.pdf",
    "edition": "consolidated through the amendment of 2026-07-01 (RG 33297)",
    "accessed": "2026-11-14",
    "paraphrase": "Riser may not exceed 16 cm in buildings without a lift and 18 cm in buildings with one."
   },
   "verified": true,
   "severity": "error",
   "id": "tr.riser"
  },
  {
   "depth": 2,
   "discipline": "arch",
   "applies": {
    "typology": [
     "house",
     "apartment",
     "apartment_section",
     "office"
    ]
   },
   "check": {
    "kind": "formula",
    "cat": "stair",
    "expr": "tread",
    "min": 0.27
   },
   "unit": "m",
   "value": 0.27,
   "text": {
    "en": "Common stair tread at least 0.27 m"
   },
   "source": {
    "doc": "tr-planli",
    "clause": "Art. 31 para 2 item b",
    "url": "https://www.alomaliye.com/wp-content/uploads/2017/07/planli-alanlar-01-07-2026.pdf",
    "edition": "consolidated through the amendment of 2026-07-01 (RG 33297)",
    "accessed": "2026-11-14",
    "paraphrase": "Tread is computed from twice the riser plus the tread being 60 to 64 cm, but never below 27 cm."
   },
   "verified": true,
   "severity": "error",
   "id": "tr.tread"
  },
  {
   "depth": 2,
   "discipline": "arch",
   "applies": {
    "typology": [
     "apartment",
     "apartment_section",
     "office"
    ]
   },
   "check": {
    "kind": "formula",
    "cat": "stair",
    "expr": "width",
    "min": 1.2
   },
   "unit": "m",
   "value": 1.2,
   "text": {
    "en": "Common stair flight width at least 1.2 m"
   },
   "source": {
    "doc": "tr-planli",
    "clause": "Art. 31 para 1 item a",
    "url": "https://www.alomaliye.com/wp-content/uploads/2017/07/planli-alanlar-01-07-2026.pdf",
    "edition": "consolidated through the amendment of 2026-07-01 (RG 33297)",
    "accessed": "2026-11-14",
    "paraphrase": "Common stair flights and landings in housing are at least 1.2 m (1.5 m in other buildings), and not less than the escape width worked out under the fire regulation."
   },
   "verified": true,
   "severity": "error",
   "id": "tr.sw"
  },
  {
   "depth": 2,
   "discipline": "arch",
   "applies": {
    "typology": [
     "house"
    ]
   },
   "check": {
    "kind": "formula",
    "cat": "stair",
    "expr": "width",
    "min": 1.0
   },
   "unit": "m",
   "value": 1.0,
   "text": {
    "en": "Stair flight width in a house at least 1.0 m"
   },
   "source": {
    "doc": "tr-planli",
    "clause": "Art. 31 para 1 item a",
    "url": "https://www.alomaliye.com/wp-content/uploads/2017/07/planli-alanlar-01-07-2026.pdf",
    "edition": "consolidated through the amendment of 2026-07-01 (RG 33297)",
    "accessed": "2026-11-14",
    "paraphrase": "Stairs inside a single dwelling unit may be as narrow as 1.0 m."
   },
   "verified": true,
   "severity": "error",
   "id": "tr.house.sw"
  },
