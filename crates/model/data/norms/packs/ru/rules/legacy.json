  {
   "id": "ex.stair.flight_width",
   "text": {
    "en": "Evacuation stair flight width by building: fire class, height and people on a floor above the first (sub-items b, a, g, v, d, e of the clause in priority order; exit-width part not checked)"
   },
   "source": {
    "doc": "sp1.13130",
    "clause": "p.4.4.1"
   },
   "severity": "error",
   "scope": {
    "cats": [
     "stair"
    ],
    "levels": null,
    "type_name": null
   },
   "check": {
    "kind": "cases",
    "value": "width",
    "require": [
     "project.fire_class",
     "project.height",
     "project.people_upper"
    ],
    "cases": [
     {
      "if": [
       {
        "param": "project.people_upper",
        "op": ">",
        "value": 600
       }
      ],
      "min": 1.6,
      "clause": "p.4.4.1 б)"
     },
     {
      "if": [
       {
        "param": "project.fire_class",
        "in": [
         "Ф1.1",
         "Ф2.1",
         "Ф2.2",
         "Ф3.4",
         "Ф4.1"
        ]
       }
      ],
      "min": 1.35,
      "clause": "p.4.4.1 а)"
     },
     {
      "if": [
       {
        "param": "project.people_upper",
        "op": ">",
        "value": 200
       }
      ],
      "min": 1.35,
      "clause": "p.4.4.1 а)"
     },
     {
      "if": [
       {
        "param": "project.fire_class",
        "in": [
         "Ф2.1",
         "Ф2.2",
         "Ф2.3",
         "Ф2.4",
         "Ф3.1",
         "Ф3.2",
         "Ф3.3",
         "Ф3.4",
         "Ф3.5",
         "Ф3.6",
         "Ф4.1",
         "Ф4.2",
         "Ф4.3",
         "Ф4.4"
        ]
       },
       {
        "param": "project.height",
        "op": ">",
        "value": 50
       }
      ],
      "min": 1.35,
      "clause": "p.4.4.1 а)"
     },
     {
      "if": [
       {
        "param": "project.fire_class",
        "eq": "Ф1.3"
       },
       {
        "param": "project.height",
        "op": "<",
        "value": 75
       }
      ],
      "min": 1.05,
      "clause": "p.4.4.1 г)"
     },
     {
      "if": [
       {
        "param": "project.fire_class",
        "eq": "Ф1.3"
       },
       {
        "param": "project.height",
        "op": ">=",
        "value": 75
       },
       {
        "param": "project.height",
        "op": "<=",
        "value": 75
       }
      ],
      "min": null,
      "clause": "p.4.4.1 г)",
      "undefined": true
     },
     {
      "if": [
       {
        "param": "project.fire_class",
        "in": [
         "Ф1.4",
         "Ф5.1",
         "Ф5.2",
         "Ф5.3",
         "Ф5.4",
         "Ф5.5",
         "Ф5.6",
         "Ф5.7"
        ]
       }
      ],
      "min": null,
      "clause": "p.4.4.1 в)",
      "undefined": true
     },
     {
      "if": [
       {
        "param": "project.fire_class",
        "not_in": [
         "Ф1.3",
         "Ф1.4",
         "Ф5.1",
         "Ф5.2",
         "Ф5.3",
         "Ф5.4",
         "Ф5.5",
         "Ф5.6",
         "Ф5.7"
        ]
       }
      ],
      "min": 1.2,
      "clause": "p.4.4.1 в)"
     },
     {
      "if": [
       {
        "param": "project.people_upper",
        "op": "<=",
        "value": 5
       }
      ],
      "min": 0.7,
      "clause": "p.4.4.1 д)"
     },
     {
      "if": [],
      "min": 0.9,
      "clause": "p.4.4.1 е)"
     }
    ]
   },
   "applies": {},
   "example": true,
   "verified": false,
   "depth": 2,
   "discipline": "fire"
  },
