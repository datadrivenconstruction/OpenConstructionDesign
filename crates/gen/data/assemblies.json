  "schema": "gen_assemblies.v1",
  "about": "Layered build-ups the generator assigns to walls, slabs and roofs. Layers run from the outside (walls) or the top (slabs, roofs) inwards; thickness in millimetres. A layer with `sizes` is sized by the generator: the smallest size that meets the rules of its use (U-value, sound insulation) is taken, and of the build-ups of one use that meet them the thinnest wins (file order on a tie). Material values are typical design values of the material class (thermal conductivity W/(m K), density kg/m3, reaction-to-fire class), our own table: an engineer checks them against the product actually used. `fire_minutes` is the fire resistance the build-up is rated for at its smallest size.",
  "physics": {
    "surface": {
      "wall": {"rsi": 0.13, "rse": 0.04, "why": "Surface resistances of a vertical element with horizontal heat flow, m2K/W."},
      "roof": {"rsi": 0.10, "rse": 0.04, "why": "Surface resistances of a roof with upward heat flow, m2K/W."},
      "ground": {"rsi": 0.17, "rse": 0.0, "why": "Downward heat flow into a slab on the ground; the soil itself is not counted, which errs on the safe side."}
    },
    "mass_law": {"a": 37.5, "b": -42.0, "why": "Weighted sound reduction index of a single-leaf element from its mass per area m' (kg/m2): Rw = a log10(m') + b; an estimate for heavy single-leaf walls and floors, not for light double-leaf ones."},
    "pitched_from_deg": 5.0,
    "fire_board": {"material": "gypsum_fire", "mm": 15, "minutes": 20, "max": 8, "why": "One layer of fire rated board on the inside face adds this many minutes of fire resistance; layers are added until a wall reaches the rating its rule asks for."}
  },
