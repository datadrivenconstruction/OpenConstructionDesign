      "keycap": {"size": 11, "line": 14, "weight": 400, "tracking": 0.2, "color": "text.secondary"},
      "tooltip_title": {"size": 12, "line": 16, "weight": 600, "tracking": 0, "color": "text.primary"},
      "tooltip_body": {"size": 12, "line": 16, "weight": 400, "tracking": 0, "color": "text.secondary"},
